<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="contract_template_view_twikey_form" model="ir.ui.view">
        <field name="name">contract.template.view.twikey.form</field>
        <field name="model">twikey.contract.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1 name="twikey_name">
                            <field name="name" placeholder="Twikey Profile" />
                        </h1>
                    </div>
                    <group name="main_group">
                        <group name="main_group_1">
                            <field name="twikey_id" />
                        </group>
                        <group name="main_group_2">
                            <field name="type" />
                        </group>
                    </group>
                    <notebook>
                        <page name="twikey_attributes">
                            <field name="twikey_attribute_ids">
                                <list>
                                    <field name="name" />
                                    <field name="type" />
                                </list>
                                <form>
                                    <sheet>
                                        <div class="oe_title">
                                            <h1 name="twikey_attribute_name">
                                                <field name="name" placeholder="Twikey Profile Attributes"/>
                                            </h1>
                                        </div>
                                        <group name="main_group">
                                            <group name="main_group_1">
                                                <field name="template_id" invisible="1" />
                                                <field name="type" />
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="contract_template_view_twikey_tree" model="ir.ui.view">
        <field name="name">contract.template.view.twikey.tree</field>
        <field name="model">twikey.contract.template</field>
        <field name="arch" type="xml">
            <list  create="false" delete="false">
                <field name="name" />
                <field name="twikey_id" />
                <field name="type" />
            </list>
        </field>
    </record>

    <record id="contract_template_action" model="ir.actions.act_window">
        <field name="name">Twikey Profiles</field>
        <field name="res_model">twikey.contract.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_action_contract_template_view"
        action="contract_template_action"
        parent="contacts.menu_contacts"
        sequence="1"
    />
</odoo>
