<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.view.twikey.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <header>
                <button class="btn-info" invisible="send_to_twikey == True" name="btn_send_to_twikey" string="Send to Twikey" type="object"/>
            </header>
            <xpath expr="//page[@name='other_info']" position="after">
                <field invisible="1" name="is_twikey_eligable"/>
                <field invisible="1" name="twikey_invoice_identifier"/>
                <page id="twikey_info" invisible="is_twikey_eligable == False" name="twikey_info" string="Twikey Info">
                    <group>
                        <field invisible="twikey_invoice_identifier != False" name="send_to_twikey"/>
                        <field invisible="twikey_invoice_identifier == False" name="id_and_link_html" widget="html"/>
                        <field invisible="twikey_invoice_identifier == False" name="twikey_template_id" readonly="state != 'draft'"/>
                        <field decoration-info="twikey_invoice_state == 'Pending'" decoration-success="twikey_invoice_state == 'Paid'" invisible="twikey_invoice_identifier == False" name="twikey_invoice_state" readonly="True" widget="badge"/>
                    </group>
                </page>
            </xpath></field>
    </record>
    <record id="model_account_move_send_to_twikey" model="ir.actions.server">
        <field name="name">Send to Twikey</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">tree,form</field>
        <field name="state">code</field>
        <field name="code">records.btn_send_to_twikey()</field>
    </record>
    <menuitem action="model_account_move_send_to_twikey" id="menu_action_twikey" parent="contacts.res_partner_menu_config" sequence="1"/>
</odoo>
