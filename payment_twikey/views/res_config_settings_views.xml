<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.twikey.form.inherit.base.setup</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='integration']" position="inside">
                <setting id="twikey_payment_parameters" title="Automate your payments">
                    <field name="activate_twikey"/>
                    <div class="content-group" id="reacaptcha_configuration_settings" invisible="not activate_twikey">
                        <div class="mt16 row">
                            <label for="twikey_base_url" string="API url" class="col-3 o_light_label"/>
                            <field name="twikey_base_url"/>
                        </div>
                        <div class="mt16 row">
                            <label for="twikey_api_key" string="API key" class="col-3 o_light_label"/>
                            <field name="twikey_api_key"/>
                        </div>
                        <div class="mt16 row">
                            <label for="twikey_auto_collect" class="col-3 o_light_label"/>
                            <span style="color: rgba(209, 209, 209, 0.76)">Should Twikey try to collect invoices directly via a recurring payment method</span>
                            <field name="twikey_auto_collect"/>
                        </div>
                        <div class="mt16 row">
                            <label for="twikey_send_invoice" class="col-3 o_light_label"/>
                            <span style="color: rgba(209, 209, 209, 0.76)">Send all invoice by default to Twikey</span>
                            <field name="twikey_send_invoice"/>
                        </div>
                        <div class="mt16 row">
                            <label for="twikey_include_purchase" class="col-3 o_light_label"/>
                            <span style="color: rgba(209, 209, 209, 0.76)">Also send purchase invoice to Twikey for payment</span>
                            <field name="twikey_include_purchase"/>
                        </div>
                        <div class="mt16 row">
                            <label for="twikey_send_pdf" class="col-3 o_light_label"/>
                            <span style="color: rgba(209, 209, 209, 0.76)">Include the PDF of the invoice to Twikey (charges may apply)</span>
                            <field name="twikey_send_pdf"/>
                        </div>
                        <button name="test_twikey_connection"
                                string="Test Connection"
                                type="object"
                                class="oe_link"
                                icon="fa-arrow-right"
                        />
                        <button name="twikey_sync_contract_template"
                                string="Sync Twikey Profiles"
                                type="object"
                                class="oe_link"
                                icon="fa-arrow-right"
                        />
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
