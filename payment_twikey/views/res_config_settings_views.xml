<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.twikey.form.inherit.base.setup</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='integration']" position="inside">
                <setting id="twikey_payment_parameters" title="Automate your payments">
                    <field name="twikey_base_url" string="API url"/>
                    <field name="twikey_api_key" string="API key"/>
                    <button name="test_twikey_connection"
                                    string="Test Connection"
                                    type="object"
                                    class="oe_link"
                                    icon="fa-arrow-right"
                                />
                    <button name="twikey_sync_contract_template"
                                    string="Sync Twikey Profiles"
                                    type="object"
                                    class="oe_link"
                                    icon="fa-arrow-right"
                                />
                </setting>
                <setting id="twikey_payment_collect" help="Should Twikey try to collect invoices directly via a recurring payment method">
                    <field name="twikey_auto_collect"/>
                </setting>
                <setting id="twikey_payment_invoice" help="Send all invoice by default to Twikey">
                    <field name="twikey_send_invoice"/>
                </setting>
                <setting id="twikey_payment_purchase" help="Also send purchase invoice to Twikey for payment">
                    <field name="twikey_include_purchase"/>
                </setting>
                <setting id="twikey_send_pdf" help="Include the PDF of the invoice to Twikey (charges may apply)">
                    <field name="twikey_include_purchase"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
