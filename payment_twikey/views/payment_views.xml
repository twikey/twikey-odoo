<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">Twikey Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_config" position="inside">
                <group name="twikey_config" string="Twikey Config" invisible="('code', '!=', 'twikey')">
                    <field name="twikey_template_id" string="Profile to use" invisible="('code', '!=', 'twikey')" />
                    <field name="twikey_method" string="Method" invisible="('code', '!=', 'twikey')" />
                </group>
            </group>
        </field>
    </record>
</odoo>
